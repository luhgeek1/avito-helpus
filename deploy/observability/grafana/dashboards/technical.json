      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(buddy_llm_fallbacks_total{job=\"api\"}[$__rate_interval])) / clamp_min(sum(rate(buddy_chat_turns_total{job=\"api\"}[$__rate_interval])), 0.001)",
          "legendFormat": "Доля фоллбэков"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
