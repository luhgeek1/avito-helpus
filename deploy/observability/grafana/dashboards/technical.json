{
  "title": "Орби — техника",
  "uid": "orbi-technical",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "orbi",
    "synthetic"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Синтетические данные, не доказательство пользы",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "API и воркер собираются раздельно. HTTP — полная длительность ответа, SSE — отдельно. Порог <1 с относится к локальным операциям. Алерты: http://localhost:9095/alerts."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 по маршрутам",
      "datasource": {
        "type": "prometheus",
        "uid": "orbi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(buddy_http_request_seconds_bucket{job=\"api\",route!~\"/api/v1/chat/.*|/api/v1/events|/api/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p99 по маршрутам",
      "datasource": {
        "type": "prometheus",
        "uid": "orbi-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(buddy_http_request_seconds_bucket{job=\"api\",route!~\"/api/v1/chat/.*|/api/v1/events|/api/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
