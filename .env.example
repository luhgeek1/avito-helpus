# Copy to .env next to docker-compose.yml. Everything is optional: without a key Orbi runs in the
# clearly marked offline mode (same tools and scenarios, rule-based answers instead of an LLM).

# LLM provider: OpenAI (or any OpenAI-compatible API via LLM_BASE_URL, e.g. OpenRouter or Ollama).
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=gpt-5.4-mini
# LLM_HEAVY_MODEL=gpt-5.4
# EMBEDDINGS_MODEL=text-embedding-3-large
# LLM_MODE=auto            # auto | online | offline

# Demo pacing: how fast the imitated approver decides, and the AI-cron tick.
MOCK_APPROVAL_DELAY_SEC=20
SCHEDULER_INTERVAL_SEC=15
# HTTP_PORT=80
