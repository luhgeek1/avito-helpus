# Local development settings: copy to backend/.env (make env). Names are case-insensitive;
# app/core/config.py lists every option. docker-compose.yml sets these for containers itself.

APP_STAGE=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Postgres (pgvector) and Redis from `make up` are published on these ports.
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/buddy
REDIS_URL=redis://localhost:6379/0

# `python -m app.cli keys` (or `make keys`) generates the pair into backend/secrets/.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public_key.pem
CSRF_HMAC_KEY=change-me
COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:5173

# LLM: any OpenAI-compatible API. Without a key Orbi runs in the marked offline mode.
# LLM_MODE=auto|online|offline
LLM_MODE=auto
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5.4-mini
LLM_HEAVY_MODEL=gpt-5.4
EMBEDDINGS_MODEL=text-embedding-3-large

# Corporate services imitation (corp-mock, MCP over streamable HTTP) and its webhook secret.
CORP_MCP_URL=http://localhost:8090/mcp
CORP_WEBHOOK_SECRET=dev-webhook-secret

# Demo pacing: SLA hours and the AI-cron tick.
ACCESS_SLA_HOURS=24
ESCALATION_SLA_HOURS=24
SCHEDULER_INTERVAL_SEC=30
# Optional synthetic analytics export (Kafka is never contacted by the API).
CLICKSTREAM_ENABLED=false
# CLICKSTREAM_HMAC_KEY=                 # at least 32 random characters, never commit
# CLICKSTREAM_HMAC_KEY_PATH=secrets/clickstream_hmac_key
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_ANALYTICS_TOPIC=buddy.analytics.v1
KAFKA_TIMEOUT_SEC=5
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9100
